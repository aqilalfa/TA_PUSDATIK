# =============================================================================
# SPBE RAG System - Cloudflare Tunnel Configuration
# =============================================================================
# Copy this file to .env.cloudflare, then fill the token from Cloudflare Zero Trust.
# Do not commit .env.cloudflare because it contains a secret tunnel token.
# =============================================================================

# Cloudflare Zero Trust > Networks > Tunnels > Create tunnel > Docker
# Paste only the token value, not the full docker command.
CLOUDFLARED_TUNNEL_TOKEN=replace-with-your-cloudflare-tunnel-token
